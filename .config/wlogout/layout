{
    "label" : "lock",
    "action" : "swaylock",
    "text" : "Lock",
    "keybind" : "l"
}

{
    "label" : "logout",
    "action" : "uwsm stop",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "windows",
    "action" : "pkexec /usr/sbin/grub-reboot 'Windows Boot Manager (on /dev/nvme1n1p1)' && systemctl reboot",
    "text" : "Reboot to Windows",
    "keybind" : "w"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}

